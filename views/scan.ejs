<head>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500&display=swap');

        * {
            font-family: Montserrat;
        }

        body {
            margin: 2vw;
        }

        .container {
            display: flex;
            justify-content: center;
            position: relative;
        }

        .ticket {
            width: 100%;
        }

        .ticketContainer {
            width: 100%;
            height: 100%;
        }

        .qrCode {
            position: absolute;
            right: 5vw;
            width: 20vw;
            height: 20vw;
            top: 5vw;
        }

        @media print {
            @page {
                margin: 2vw;
            }
        }
    </style>
</head>

<body onload="window.print()">
    <div class="ticketContainer">
        <img class="qrCode" src=<%=src%> alt="QR Code Image">
        <img class="ticket" src='assets/bg.jpeg'>
    </div>
</body>

</html>