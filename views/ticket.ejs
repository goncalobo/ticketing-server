<head>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500&display=swap');

        * {
            font-family: Montserrat;
        }

        body {
            margin: 4vw;
        }

        .container {
            display: flex;
            justify-content: center;
            position: relative;
        }

        .details {
            position: absolute;
            bottom: 8vw;
            right: 8vw;
            color: white;
            text-align: right;
            font-size: 2vw;
        }

        .ticket {
            width: 100%;
        }

        .ticketContainer {
            width: 100%;
            position: relative;
        }

        .qrCode {
            position: absolute;
            right: 5vw;
            width: 30vw;
            height: 30vw;
            top: 5vw;
        }

        @media print {
            @page {
                margin: 4vw;
            }
        }
    </style>
</head>

<body>
    <div class="ticketContainer">
        <div class="details">
            <div><b><%=attendee.first_name%> <%=attendee.last_name%></b></div>
            <div>
                <%=attendee.occupation%>
            </div>
        </div>
        <img class="qrCode" src=<%=assets.qrCode%> alt="QR Code Image">
        <img class="ticket" src=<%=assets.background%>>
    </div>
</body>

</html>