<head>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500&display=swap');

        * {
            font-family: Montserrat;
        }

        body {
            margin: 2vw;
        }

        .container {
            display: flex;
            justify-content: center;
            position: relative;
        }

        .details {
            position: absolute;
            bottom: 8vw;
            right: 8vw;
            color: white;
            text-align: right;
            font-size: 2vw;
        }

        .ticket {
            width: 100%;
        }

        .ticketContainer {
            width: 100%;
            position: relative;
        }

        .qrCode {
            position: absolute;
            right: 5vw;
            width: 20vw;
            height: 20vw;
            top: 5vw;
        }

        @media print {
            @page {
                margin: 2vw;
            }
        }
    </style>
</head>

<body onload="window.print()">
    <div class="ticketContainer">
        <div class="details">
            <div><b>
                    <%=content.first_name%>
                        <%=content.last_name%>
                </b></div>
            <div>
                <%=content.occupation%>
            </div>
        </div>
        <img class="qrCode" src=<%=src%> alt="QR Code Image">
        <img class="ticket" src='assets/bg.jpeg'>
    </div>
</body>

</html>